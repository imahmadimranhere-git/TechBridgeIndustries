# ===== App =====
NODE_ENV=development
PORT=5000
APP_TIMEZONE=Asia/Karachi
LOG_LEVEL=info

# ===== URLs =====
# React app address (used for CORS and QR verification links)
FRONTEND_URL=http://localhost:5173
# This API's public address (used to build absolute file URLs)
SERVER_URL=http://localhost:5000

# ===== Database =====
# Must be a replica set (MongoDB Atlas clusters already are).
# Local example: mongodb://127.0.0.1:27017/techbridge?replicaSet=rs0
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/techbridge?retryWrites=true&w=majority

# ===== Auth =====
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_generated_secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=tbi_token

# ===== First admin (used only by the seeder) =====
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@techbridgeindustries.com
SEED_ADMIN_PASSWORD=ChangeMe@123

# ===== Email (SMTP) - optional until Phase 13 =====
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TechBridgeIndustries <no-reply@techbridgeindustries.com>"

# ===== Uploads & PDFs =====
UPLOAD_MAX_SIZE_MB=2
# Leave empty to use the Chrome that Puppeteer downloaded
PUPPETEER_EXECUTABLE_PATH=

# ===== Jobs =====
# Every day at 01:00 (in APP_TIMEZONE)
OVERDUE_CRON="0 1 * * *"