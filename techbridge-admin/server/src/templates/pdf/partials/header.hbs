<header class="doc-header">
  <div class="doc-header__logo">
    {{#if branding.logoDataUri}}
      <img src="{{branding.logoDataUri}}" alt="{{branding.company.name}}">
    {{else}}
      <div class="text-logo">
        <div class="text-logo__badge">{{branding.initials}}</div>
        <div class="text-logo__name">{{branding.company.name}}</div>
      </div>
    {{/if}}
  </div>

  <div class="doc-header__company">
    <div class="company-name">{{branding.company.name}}</div>
    {{#if branding.company.tagline}}<div class="tagline">{{branding.company.tagline}}</div>{{/if}}
    <div class="contact-list">
      {{#if branding.company.addressLine}}
        <div class="contact-item">{{icon "map-pin"}}<span>{{branding.company.addressLine}}</span></div>
      {{/if}}
      {{#if branding.company.phone}}
        <div class="contact-item">{{icon "phone"}}<span>{{branding.company.phone}}</span></div>
      {{/if}}
      {{#if branding.company.email}}
        <div class="contact-item">{{icon "mail"}}<span>{{branding.company.email}}</span></div>
      {{/if}}
      {{#if branding.company.website}}
        <div class="contact-item">{{icon "globe"}}<span>{{branding.company.website}}</span></div>
      {{/if}}
    </div>
  </div>
</header>