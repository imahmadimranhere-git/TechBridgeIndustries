:root {
  --brand: {{branding.colors.primary}};
  --brand-2: {{branding.colors.secondary}};
  --brand-soft: color-mix(in srgb, var(--brand) 8%, white);
  --text: #111827;
  --muted: #6b7280;
  --border: #e5e7eb;
  --zebra: #f8fafc;
  --success: #15803d;
  --warning: #c2410c;
  --danger: #b91c1c;
  --info: #1d4ed8;
  --neutral: #6b7280;
}

* { box-sizing: border-box; }
html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }

body {
  margin: 0;
  font-family: 'DocFont', 'Noto Sans', 'Segoe UI', Arial, sans-serif;
  font-size: 10pt;
  line-height: 1.5;
  color: var(--text);
}

h1, h2, h3 { margin: 0; color: var(--brand); line-height: 1.25; }
p { margin: 0 0 8px; }

/* ---------- Header ---------- */
.doc-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24px;
  padding-bottom: 12px;
  margin-bottom: 18px;
  border-bottom: 3px solid var(--brand);
}
.doc-header__logo img { max-height: 60px; max-width: 210px; object-fit: contain; }
.text-logo { display: flex; align-items: center; gap: 10px; }
.text-logo__badge {
  width: 42px; height: 42px; border-radius: 10px;
  background: var(--brand); color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-weight: 700; font-size: 13pt; letter-spacing: 0.5px;
}
.text-logo__name { font-size: 15pt; font-weight: 700; color: var(--brand); }
.doc-header__company { text-align: right; font-size: 8.5pt; color: var(--muted); line-height: 1.45; }
.doc-header__company .company-name { font-size: 12pt; font-weight: 700; color: var(--text); }
.doc-header__company .tagline { font-style: italic; }

/* ---------- Title & panels ---------- */
.doc-title { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 16px; }
.doc-title h1 { font-size: 20pt; letter-spacing: 1px; text-transform: uppercase; }
.doc-title .doc-number { font-size: 10pt; color: var(--muted); text-align: right; }

.meta-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-bottom: 16px; }
.panel { border: 1px solid var(--border); border-radius: 8px; padding: 10px 12px; }
.panel--soft { background: var(--brand-soft); border-color: transparent; }
.panel__label {
  font-size: 7.5pt; font-weight: 700; letter-spacing: 0.6px;
  text-transform: uppercase; color: var(--brand); margin-bottom: 4px;
}
.section-title { font-size: 10.5pt; margin: 18px 0 6px; }

/* ---------- Tables ---------- */
table.data { width: 100%; border-collapse: collapse; margin: 8px 0 16px; font-size: 9pt; }
table.data th {
  background: var(--brand); color: #fff; font-weight: 700;
  text-align: left; padding: 7px 8px; font-size: 8.5pt;
}
table.data td { padding: 6px 8px; border-bottom: 1px solid var(--border); vertical-align: top; }
table.data tbody tr:nth-child(even) td { background: var(--zebra); }
table.data tr { break-inside: avoid; page-break-inside: avoid; }
table.data th.num, .num, .amount { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }

.totals { margin-left: auto; width: 46%; border-collapse: collapse; font-size: 9.5pt; }
.totals td { padding: 5px 8px; }
.totals tr.grand td {
  border-top: 2px solid var(--brand);
  font-weight: 700; font-size: 11pt; color: var(--brand);
}

/* ---------- Small utilities ---------- */
.muted { color: var(--muted); }
.small { font-size: 8pt; }
.bold { font-weight: 700; }
.avoid-break { break-inside: avoid; page-break-inside: avoid; }

.badge {
  display: inline-block; padding: 1px 8px; border-radius: 999px;
  font-size: 7.5pt; font-weight: 700; letter-spacing: 0.4px; text-transform: uppercase;
  border: 1px solid currentColor;
}
.badge--success { color: var(--success); }
.badge--warning { color: var(--warning); }
.badge--danger { color: var(--danger); }
.badge--info { color: var(--info); }
.badge--neutral { color: var(--neutral); }

/* ---------- Icons ---------- */
.icon { width: 9pt; height: 9pt; color: var(--brand); }
.contact-list { margin-top: 3px; }
.contact-item { display: flex; justify-content: flex-end; align-items: center; gap: 4px; }

/* ---------- Status stamps (rubber-stamp look) ---------- */
.document { position: relative; }

.status-stamp {
  position: absolute;
  top: 62px;
  right: 6px;
  z-index: 5;
  padding: 6px 16px;
  border: 3.5px double currentColor;
  border-radius: 8px;
  font-size: 19pt;
  font-weight: 700;
  letter-spacing: 3px;
  text-transform: uppercase;
  transform: rotate(-12deg);
  opacity: 0.82;
  mix-blend-mode: multiply;
  pointer-events: none;
}
.status-stamp--success { color: var(--success); }
.status-stamp--warning { color: var(--warning); }
.status-stamp--danger  { color: var(--danger); }
.status-stamp--info    { color: var(--info); }
.status-stamp--neutral { color: var(--neutral); }

.status-stamp--inline {
  position: static;
  display: inline-block;
  padding: 1px 6px;
  border-width: 1.5px;
  border-style: solid;
  border-radius: 4px;
  font-size: 6.5pt;
  letter-spacing: 1px;
  transform: rotate(-6deg);
}

/* position: fixed repeats the watermark on every printed page */
.draft-watermark {
  position: fixed;
  top: 38%;
  left: 0;
  right: 0;
  z-index: 0;
  text-align: center;
  font-size: 110pt;
  font-weight: 700;
  letter-spacing: 14px;
  color: rgba(107, 114, 128, 0.12);
  transform: rotate(-30deg);
  pointer-events: none;
}

/* ---------- Authorized signatory ---------- */
.signatory { display: flex; justify-content: flex-end; margin-top: 30px; }
.signatory__box { position: relative; width: 230px; text-align: center; font-size: 8.5pt; }
.signatory__signature { height: 62px; display: flex; align-items: flex-end; justify-content: center; }
.signatory__signature img { max-height: 60px; max-width: 200px; object-fit: contain; }

/* The company stamp overlaps the signature slightly, like a real stamped document */
.signatory__stamp {
  position: absolute;
  left: -64px;
  top: -30px;
  width: 120px;
  height: 120px;
  object-fit: contain;
  opacity: 0.8;
  mix-blend-mode: multiply;
  pointer-events: none;
}

.signatory__line { border-top: 1.2px solid var(--text); margin: 4px 14px 5px; }
.signatory__name { font-weight: 700; font-size: 9.5pt; }
.signatory__designation { color: var(--muted); }
.signatory__company { font-weight: 700; color: var(--brand); }
.signatory__label { margin-top: 2px; font-size: 7.5pt; color: var(--muted); text-transform: uppercase; letter-spacing: 0.5px; }

/* ---------- Phase 12: document building blocks ---------- */
.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 12px; }

table.kv { width: 100%; border-collapse: collapse; font-size: 9pt; }
table.kv td { padding: 2px 0; vertical-align: top; }
table.kv td:first-child { color: var(--muted); padding-right: 10px; white-space: nowrap; }
table.kv td:last-child { text-align: right; font-weight: 600; }

.stat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 6px 0 16px; }
.stat-grid--4 { grid-template-columns: repeat(4, 1fr); }
.stat { border: 1px solid var(--border); border-left: 3px solid var(--brand); border-radius: 8px; padding: 8px 10px; break-inside: avoid; }
.stat__label { font-size: 7.5pt; color: var(--muted); text-transform: uppercase; letter-spacing: 0.4px; }
.stat__value { font-size: 12pt; font-weight: 700; font-variant-numeric: tabular-nums; }
.stat--success { border-left-color: var(--success); }
.stat--warning { border-left-color: var(--warning); }
.stat--danger { border-left-color: var(--danger); }
.stat--info { border-left-color: var(--info); }
.stat--purple { border-left-color: #7c3aed; }

/* Main financial values in the report, colour-coded like the dashboard */
.stat--totalReceived { border-left-color: var(--info); }
.stat--commissionPaid { border-left-color: var(--warning); }
.stat--cashInHand { border-left-color: var(--success); }
.stat--netProfit { border-left-color: #7c3aed; }

.amount-hero { text-align: center; padding: 14px; margin: 6px 0 16px; border-radius: 10px; background: var(--brand-soft); }
.amount-hero__label { font-size: 8pt; text-transform: uppercase; letter-spacing: 0.6px; color: var(--muted); }
.amount-hero__value { font-size: 24pt; font-weight: 700; color: var(--brand); font-variant-numeric: tabular-nums; }

table.data--compact { font-size: 8pt; }
table.data--compact th, table.data--compact td { padding: 4px 6px; }
table.data tr.row-strong td { font-weight: 700; background: var(--brand-soft) !important; }
.totals tr.balance td { font-weight: 700; background: var(--brand-soft); }

.text-box { font-size: 8.5pt; color: var(--muted); }
.footnote { font-size: 7.5pt; color: var(--muted); margin-top: -10px; margin-bottom: 12px; }

/* Welcome letter */
.letter-meta { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; }
.letter-title { font-size: 16pt; margin-bottom: 12px; }
.letter p { margin: 0 0 10px; text-align: justify; line-height: 1.7; }
.services { list-style: none; padding: 0; margin: 4px 0 8px; columns: 2; column-gap: 24px; }
.services li { display: flex; align-items: center; gap: 6px; padding: 2px 0; break-inside: avoid; }

/* Two signatories side by side (stamp stays on the right-hand, main signer) */
.signatory { gap: 80px; align-items: flex-end; }

/* Three signatories (all founders): narrower boxes so they fit across an A4 page */
.signatory--three { gap: 28px; }
.signatory--three .signatory__box { width: 196px; }
.signatory--three .signatory__designation { font-size: 7.5pt; }
.signatory--three .signatory__stamp { left: -44px; top: -24px; width: 104px; height: 104px; }

/* Welcome letter: founders / points of contact */
.contacts { display: grid; gap: 8px; }
.contact-card { padding-bottom: 6px; border-bottom: 1px dashed var(--border); }
.contact-card:last-child { border-bottom: 0; padding-bottom: 0; }
.contact-card__line { display: flex; align-items: center; gap: 5px; font-size: 8.5pt; color: var(--muted); }
