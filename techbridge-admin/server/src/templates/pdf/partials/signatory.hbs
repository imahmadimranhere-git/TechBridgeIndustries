{{#if signatory}}
<section class="signatory avoid-break{{#if signatory.coSigners.[1]}} signatory--three{{/if}}">
  {{#each signatory.coSigners}}
    <div class="signatory__box">
      <div class="signatory__signature">
        {{#if signatureDataUri}}
          <img src="{{signatureDataUri}}" alt="Signature">
        {{/if}}
      </div>
      <div class="signatory__line"></div>
      <div class="signatory__name">{{name}}</div>
      {{#if designation}}<div class="signatory__designation">{{designation}}</div>{{/if}}
      <div class="signatory__company">{{@root.signatory.companyName}}</div>
      <div class="signatory__label">{{@root.signatory.label}} &middot; {{date @root.signatory.date}}</div>
    </div>
  {{/each}}

  <div class="signatory__box">
    {{#if signatory.stampDataUri}}
      <img class="signatory__stamp" src="{{signatory.stampDataUri}}" alt="">
    {{/if}}

    <div class="signatory__signature">
      {{#if signatory.signatureDataUri}}
        <img src="{{signatory.signatureDataUri}}" alt="Signature">
      {{/if}}
    </div>

    <div class="signatory__line"></div>
    {{#if signatory.name}}<div class="signatory__name">{{signatory.name}}</div>{{/if}}
    {{#if signatory.designation}}<div class="signatory__designation">{{signatory.designation}}</div>{{/if}}
    <div class="signatory__company">{{signatory.companyName}}</div>
    <div class="signatory__label">{{signatory.label}} &middot; {{date signatory.date}}</div>
  </div>
</section>
{{/if}}
