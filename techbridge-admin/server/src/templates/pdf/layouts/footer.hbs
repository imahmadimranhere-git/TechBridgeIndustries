<div style="width:100%; padding:0 14mm; font-family:'Segoe UI', Arial, sans-serif; font-size:7.5px; color:#6b7280; -webkit-print-color-adjust:exact;">
  <div style="border-top:1.5px solid {{branding.colors.primary}}; padding-top:5px; display:flex; align-items:center; justify-content:space-between; gap:12px;">
    <div style="flex:1; line-height:1.6;">
      <div style="font-weight:700; color:#111827; font-size:8px;">{{branding.footerText}}</div>
      <div style="display:flex; flex-wrap:wrap; gap:10px;">
        {{#if branding.company.website}}
          <span style="display:inline-flex; align-items:center; gap:3px;">{{icon "globe" size=8 color=branding.colors.primary}}{{branding.company.website}}</span>
        {{/if}}
        {{#if branding.company.email}}
          <span style="display:inline-flex; align-items:center; gap:3px;">{{icon "mail" size=8 color=branding.colors.primary}}{{branding.company.email}}</span>
        {{/if}}
        {{#if branding.company.phone}}
          <span style="display:inline-flex; align-items:center; gap:3px;">{{icon "phone" size=8 color=branding.colors.primary}}{{branding.company.phone}}</span>
        {{/if}}
      </div>
    </div>

    {{#if verification}}
      <div style="display:flex; align-items:center; gap:7px; text-align:right;">
        <div style="line-height:1.45;">
          <div style="display:flex; align-items:center; justify-content:flex-end; gap:3px;">{{icon "shield-check" size=9 color=branding.colors.primary}}Scan or visit to verify</div>
          <div style="font-family:Consolas, monospace; font-weight:700; color:#111827; font-size:8px;">{{verification.code}}</div>
          <div>Page <span class="pageNumber"></span> of <span class="totalPages"></span></div>
        </div>
        <img src="{{verification.qrDataUri}}" style="width:44px; height:44px;">
      </div>
    {{else}}
      <div>Page <span class="pageNumber"></span> of <span class="totalPages"></span></div>
    {{/if}}
  </div>
</div>