<h1 style="margin:0 0 14px; font-size:20px; line-height:1.3; color:{{branding.colors.primary}};">{{heading}}</h1>

<p style="margin:0 0 12px;">Dear {{or greetingName "Sir/Madam"}},</p>

{{#each intro}}
  <p style="margin:0 0 12px;">{{this}}</p>
{{/each}}

{{#if message}}
  <div style="margin:0 0 16px; padding:12px 14px; background:#f9fafb; border-left:3px solid {{branding.colors.primary}}; border-radius:6px;">{{nl2br message}}</div>
{{/if}}

{{#if rows.length}}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:6px 0 16px; border:1px solid #e5e7eb; border-radius:8px; border-collapse:separate;">
    {{#each rows}}
      <tr>
        <td style="padding:9px 14px; font-size:13px; color:#6b7280;{{#unless @last}} border-bottom:1px solid #e5e7eb;{{/unless}}">{{label}}</td>
        <td align="right" style="padding:9px 14px; font-size:13px; font-weight:600; color:#111827;{{#unless @last}} border-bottom:1px solid #e5e7eb;{{/unless}}">{{value}}</td>
      </tr>
    {{/each}}
  </table>
{{/if}}

{{#if attachmentName}}
  <p style="margin:0 0 14px; font-size:13px; color:#6b7280;">Attached: <strong style="color:#111827;">{{attachmentName}}</strong></p>
{{/if}}

{{#if verification}}
  <table role="presentation" cellpadding="0" cellspacing="0" style="margin:4px 0 10px;">
    <tr>
      <td style="border-radius:8px; background:{{branding.colors.primary}};">
        <a href="{{verification.url}}" style="display:inline-block; padding:10px 18px; font-size:13px; font-weight:600; color:#ffffff; text-decoration:none;">Verify this document</a>
      </td>
    </tr>
  </table>
  <p style="margin:0 0 14px; font-size:12px; color:#6b7280;">Verification code: <strong style="font-family:Consolas, monospace; color:#111827;">{{verification.code}}</strong></p>
{{/if}}

<p style="margin:18px 0 0;">
  Kind regards,<br>
  <strong>{{or sender.name branding.company.name}}</strong>
  {{#if sender.designation}}<br><span style="color:#6b7280;">{{sender.designation}}</span>{{/if}}
  <br><span style="color:#6b7280;">{{branding.company.name}}</span>
</p>